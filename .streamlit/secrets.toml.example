# Copy to .streamlit/secrets.toml — never commit the real file.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate-a-long-random-string"
client_id = "REPLACE-ME.apps.googleusercontent.com"
client_secret = "REPLACE-ME"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[auth.client_kwargs]
prompt = "select_account"
hd = "theodi.org"

[stewards]
api_base_url = "https://stewards-api.internal.theodi.org"
api_token = "REPLACE-ME"
env = "prod"
contact_threshold_days = 7
# Where the sidebar's Documentation link points. Defaults to the project's GitHub Pages site.
# docs_url = "https://openactive-contrib.github.io/openactive-admin-dashboard/"
